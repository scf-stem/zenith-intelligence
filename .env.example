# Zenith Intelligence - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===== 必需配置 =====

# DeepSeek API (默认文本模型，用于题目解析、解题和编程助手)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEFAULT_MODEL_PROVIDER=deepseek

# ===== 多模态模型配置 (图像识别) =====
# 图片识别仍使用 Ark/Doubao 视觉模型，识别出的文本会交给 DeepSeek 解析和解答。
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-0-pro-260215

# ===== 可选配置 =====

# JWT 密钥 (用于用户认证)
JWT_SECRET=your_jwt_secret_key

# ===== 数据持久化 =====
# 生产环境默认会把 SQLite 数据库写入 Zeabur 挂载盘 /data/app.db。
# 如果你的挂载目录不是 /data，可改为对应目录；DATABASE_URL 仍可用于覆盖为 PostgreSQL 等数据库。
ZENITH_DATA_DIR=/data
# DATABASE_URL=sqlite:////data/app.db

# ===== 应用部署 =====

# 主应用端口
APP_PORT=8080
FLASK_ENV=production
PORT=8080

# 前端访问后端 API 的运行时地址。留空时同源访问；本地静态服务会自动回退到 http://localhost:5001。
VITE_API_BASE_URL=
